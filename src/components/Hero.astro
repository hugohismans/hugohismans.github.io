---
import { useT, type Lang } from '../i18n/ui';
import { typo } from '../lib/typo';
import { stats, fmtNumber } from '../lib/catalogue';
import { SITE } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const T = (k: Parameters<typeof t>[0], v: Record<string, string | number> = {}) => typo(t(k, v), lang);
const n = (x: number) => fmtNumber(x, lang);
// Le nom est découpé en lettres au build (entrée animée en CSS, graisse au pointeur en JS).
const [first, ...rest] = SITE.author.split(' ');
const lines = [first, rest.join(' ')];
const split = lines.map((line, li) => [...line].map((ch, j) => ({ ch, i: li * 3 + j })));
---
<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <p class="kicker hero__kicker hero__fade" style="--d:0"><span>{t('hero.kicker.catalogue')}</span><span>{t('hero.kicker.objects', { n: stats.projects })}</span><span>{t('hero.kicker.clusters', { n: stats.clusters })}</span><span>{t('hero.kicker.commits', { n: n(stats.commits) })}</span></p>
    <h1 class="hero__title" id="hero-title" tabindex="-1"><span class="sr-only">{SITE.author}</span>{split.map((letters, li) => (
      <span class:list={['hero__line', li === 1 && 'hero__line--it']} aria-hidden="true">{letters.map((l) => <span class="ch" style={`--i:${l.i}`}>{l.ch}</span>)}</span>
    ))}</h1>
    <p class="hero__lede hero__fade" style="--d:150" set:html={T('hero.lede')} />
    <div class="hero__cta hero__fade" style="--d:300">
      <a class="btn btn--primary" href="#phares">{t('hero.cta.go')}<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 2v12M3 9l5 5 5-5"/></svg></a>
      <a class="btn btn--ghost" href="#atlas">{t('hero.cta.atlas', { n: stats.projects })}</a>
    </div>
  </div>
  <div class="hero__foot hero__fade" style="--d:450">
    <p class="hero__from" set:html={T('hero.from')} />
    <span class="hero__scroll" aria-hidden="true"><i></i>{t('hero.scroll')}</span>
    <p class="hero__bh-cap"><b>{t('hero.bh.title')}</b><span class="gl-only">{T('hero.bh.gl')}</span><span class="nogl-only">{T('hero.bh.nogl')} <a class="gl-retry" href="#avec3d" hidden>{t('hero.bh.retry')}</a></span></p>
  </div>
</section>
